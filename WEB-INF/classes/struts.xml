<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE struts PUBLIC
       "-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
       "http://struts.apache.org/dtds/struts-2.0.dtd">

<struts>
	<package name="default" extends="struts-default">		
		<action name="CadastroAction" class="br.ecom.projeto.actions.CadastroAction">
			<result name="success">/CadastroController</result>
		</action>		
		<action name="LoginAction" class="br.ecom.projeto.actions.LoginAction">
			<result name="input">/login.jsp</result>
			<result name="valido">/index.jsp</result>
			<result name="invalido">/login-error.jsp</result>
			<result name="administrador">/ofertas-controle.jsp</result>
		</action>
	</package>
</struts>